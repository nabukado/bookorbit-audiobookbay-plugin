# The private signing key and any key material stay outside the repository.
*.pem
*.key

# Local project memory and scratch work.
memory.md
.scratch/
node_modules/

# Reference clones used while developing; not part of the deliverable.
refs/

# Credential-probe scratch (session cookies).
.probe/

# Key material for signing releases. Never commit: generate it outside the repository for a real
# release and keep it where only you can read it.
keys/
